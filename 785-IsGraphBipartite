1class Solution {
2private:
3    bool dfs(int node, int col, vector<vector<int>> &graph, vector<int> &coloured){
4        coloured[node]=col;
5        for(int it:graph[node]){
6            if(coloured[it]==-1){
7                if(dfs(it,!col,graph,coloured)==false) return false;
8            }
9            else if(coloured[it]==col){
10                return false;
11            }
12        }
13        return true;
14    }
15public:
16    bool isBipartite(vector<vector<int>>& graph) {
17        int v=graph.size();
18        vector<int> coloured(v,-1);
19        for(int i=0;i<graph.size();i++){
20            if(coloured[i]==-1){
21                if(dfs(i,0,graph,coloured)==false) return false;
22            }
23        }
24        return true;
25    }
26};